  "keywords": [
    "encryption",
    "ecdh",
    "webcrypto",
    "e2e",
    "text"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "python3 -m http.server 4173 --bind 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tools/ui-smoke.mjs",
    "build": "node tools/build-standalone.mjs",
    "cli": "node tools/cli.mjs"
  }
}
